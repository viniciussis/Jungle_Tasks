{
  "name": "jungle-tasks",
  "author": "Vinícius Silva Santos",
  "version": "0.1.0",
  "description": "A full-stack collaborative task management system built with React, NestJS, and RabbitMQ — featuring real-time notifications, authentication, and a clean, responsive UI. Designed as a monorepo powered by Turborepo and PNPM.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciussis/Jungle_Tasks"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tree": "bash -c \"tree -I 'node_modules|dist' > project-structure.tree\"",
    "diff": "git diff HEAD > changes.diff",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.37.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  },
  "keywords": [
    "fullstack",
    "monorepo",
    "turborepo",
    "pnpm",
    "nestjs",
    "react",
    "typescript",
    "microservices",
    "rabbitmq",
    "task-management",
    "collaboration",
    "real-time",
    "docker",
    "websocket",
    "typeorm",
    "jwt",
    "api-gateway"
  ]
}
